    "session_ended": {"required": ["reason"], "properties": {"reason": "string"}},
    "unclean_exit_detected": {"required": [], "properties": {}},
    "run_started": {"required": ["biome_id"], "properties": {"biome_id": "string", "equipped_weapon_id": "string", "equipped_armor_id": "string", "companion_id": "string", "skill_loadout_ids": "string_array"}},
    "run_finished": {"required": ["result", "biome_id", "run_level", "combats_won", "active_synergy_count", "duration_bucket"], "properties": {"result": "string", "biome_id": "string", "run_level": "int", "combats_won": "int", "board_progress_bucket": "string", "boss_id": "string", "active_synergy_count": "int", "active_synergy_ids": "string_array", "loot_rarity": "string", "duration_bucket": "string", "ash_earned_bucket": "string", "ember_slash_uses": "int", "ashen_guard_uses": "int", "second_wind_uses": "int", "reason": "string"}},
    "run_abandoned": {"required": ["biome_id", "board_position", "run_level", "combats_won"], "properties": {"biome_id": "string", "board_position": "int", "run_level": "int", "combats_won": "int", "board_progress_bucket": "string"}},
    "route_choice_shown": {"required": ["biome_id", "option_a_type", "option_b_type", "player_hp_bucket"], "properties": {"biome_id": "string", "option_a_type": "string", "option_b_type": "string", "option_a_distance": "int", "option_b_distance": "int", "player_hp_bucket": "string"}},
    "route_choice_selected": {"required": ["biome_id", "chosen_type", "chosen_distance", "player_hp_bucket"], "properties": {"biome_id": "string", "chosen_type": "string", "chosen_distance": "int", "player_hp_bucket": "string"}},
    "event_choice_shown": {"required": ["biome_id", "event_id", "option_ids", "player_hp_bucket"], "properties": {"biome_id": "string", "event_id": "string", "option_ids": "string_array", "player_hp_bucket": "string"}},
    "event_choice_selected": {"required": ["biome_id", "event_id", "option_id", "reward_type", "player_hp_bucket"], "properties": {"biome_id": "string", "event_id": "string", "option_id": "string", "reward_type": "string", "player_hp_bucket": "string"}},
    "treasure_choice_shown": {"required": ["biome_id", "offer_types", "player_hp_bucket"], "properties": {"biome_id": "string", "offer_types": "string_array", "player_hp_bucket": "string"}},
    "treasure_choice_selected": {"required": ["biome_id", "offer_id", "reward_type", "player_hp_bucket"], "properties": {"biome_id": "string", "offer_id": "string", "reward_type": "string", "player_hp_bucket": "string"}},
    "combat_started": {"required": ["encounter_type", "enemy_count", "biome_id", "board_progress_bucket"], "properties": {"encounter_type": "string", "enemy_count": "int", "enemy_ids": "string_array", "template_id": "string", "biome_id": "string", "board_progress_bucket": "string"}},
    "combat_finished": {"required": ["result", "turn_count", "player_hp_bucket", "companion_alive", "enemy_count"], "properties": {"result": "string", "turn_count": "int", "player_hp_bucket": "string", "companion_alive": "bool", "enemy_count": "int", "encounter_type": "string"}},
    "enemy_intent_shown": {"required": ["category", "intensity", "target_known", "is_boss"], "properties": {"category": "string", "intensity": "string", "target_known": "bool", "is_boss": "bool"}},
