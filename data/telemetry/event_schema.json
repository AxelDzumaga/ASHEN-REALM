    "boss_finished": {"required": ["boss_id", "result", "phase_reached"], "properties": {"boss_id": "string", "result": "string", "phase_reached": "int"}},
    "boss_phase_reached": {"required": ["boss_id", "phase"], "properties": {"boss_id": "string", "phase": "int"}},
    "synergy_activated": {"required": ["synergy_id"], "properties": {"synergy_id": "string"}},
