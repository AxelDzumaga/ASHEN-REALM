    "meta_unlock_purchased": {"required": ["unlock_id", "ash_cost"], "properties": {"unlock_id": "string", "ash_cost": "int"}},
    "meta_loadout_selected": {"required": ["option_id"], "properties": {"option_id": "string"}},
    "duplicate_converted": {"required": ["equipment_id", "duplicate_count", "ash_awarded"], "properties": {"equipment_id": "string", "duplicate_count": "int", "ash_awarded": "int"}},
    "error_reported": {"required": ["error_code", "system", "context_code"], "properties": {"error_code": "string", "system": "string", "context_code": "string", "fatal": "bool"}}
  }
}
