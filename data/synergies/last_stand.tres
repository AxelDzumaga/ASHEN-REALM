[gd_resource type="Resource" script_class="SynergyData" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/data/synergy_data.gd" id="1"]
[resource]
script = ExtResource("1")
synergy_id = &"last_stand"
display_name = "LAST STAND"
description = "La última brasa sostiene una segunda defensa al borde de la derrota."
