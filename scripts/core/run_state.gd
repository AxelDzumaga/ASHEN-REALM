static func _read_route_branches(data: Dictionary, key: String) -> Dictionary:
	var result: Dictionary = {}
	var raw: Variant = data.get(key, {})
	if typeof(raw) != TYPE_DICTIONARY:
		return result
	var raw_dict: Dictionary = raw
	for raw_key: Variant in raw_dict:
		var fork_index: int = int(String(raw_key)) if String(raw_key).is_valid_int() else -1
		if fork_index < 0:
			continue
		var branch_data: Variant = raw_dict[raw_key]
		if typeof(branch_data) != TYPE_DICTIONARY:
			continue
		var branch: RouteBranchData = _RouteBranchData.from_dictionary(branch_data)
		if branch != null:
			result[fork_index] = branch
	return result


static func _string_names_to_strings(values: Array[StringName]) -> Array[String]:
	var result: Array[String] = []
	for value: StringName in values:
		result.append(String(value))
	return result


static func _string_name_int_dict_to_string_dict(values: Dictionary) -> Dictionary:
	var result: Dictionary = {}
	for key: Variant in values:
		result[String(key)] = int(values[key])
	return result


static func _string_name_float_dict_to_string_dict(values: Dictionary) -> Dictionary:
	var result: Dictionary = {}
	for key: Variant in values:
		result[String(key)] = float(values[key])
	return result


static func _read_string_name_array(data: Dictionary, key: String) -> Array[StringName]:
	var result: Array[StringName] = []
	var raw: Variant = data.get(key, [])
	if typeof(raw) != TYPE_ARRAY:
		return result
	for value: Variant in raw:
		if typeof(value) == TYPE_STRING or typeof(value) == TYPE_STRING_NAME:
			result.append(StringName(String(value)))
	return result


