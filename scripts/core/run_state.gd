		"equipment_skill_damage_bonus": equipment_skill_damage_bonus,
		"equipment_resistance_bonuses": _string_name_float_dict_to_string_dict(equipment_resistance_bonuses),
		"telemetry_started": telemetry_started,
		"telemetry_finished": telemetry_finished,
		"telemetry_started_unix": telemetry_started_unix,
		"telemetry_skill_uses": telemetry_skill_uses.duplicate(),
		"telemetry_synergy_ids": _string_names_to_strings(telemetry_synergy_ids),
		"telemetry_last_boss_id": String(telemetry_last_boss_id),
		"telemetry_boss_phase_reached": telemetry_boss_phase_reached,
		"starting_option_id": String(starting_option_id),
	}


static func from_dictionary(data: Dictionary) -> RunState:
	var run := RunState.new()
	run.run_id = _read_string(data, "run_id")
	run.started_at_unix = _read_int(data, "started_at_unix", run.started_at_unix, 0, 99_999_999_999)
	run.biome_id = StringName(_read_string(data, "biome_id"))
	run.biome_data = BiomeCatalog.get_by_id(run.biome_id)
	run.board_seed = _read_int(data, "board_seed", BoardGenerator.NO_SEED, -2_000_000_000, 2_000_000_000)
	run.board_tile_sequence = _read_int_array(data, "board_tile_sequence")
	run.route_branches = _read_route_branches(data, "route_branches")
	run.last_normal_encounter_signature = StringName(_read_string(data, "last_normal_encounter_signature"))
	run.biome_intro_shown = _read_bool(data, "biome_intro_shown")
	run.player_name = _read_string(data, "player_name", run.player_name)
	run.active_skill_id = StringName(_read_string(data, "active_skill_id", String(ActiveSkillCatalog.DEFAULT_SKILL_ID)))
	run.equipped_skill_ids = _read_string_name_array(data, "equipped_skill_ids")
	run.equipped_companion_id = StringName(_read_string(data, "equipped_companion_id"))
	run.equipped_weapon_id = StringName(_read_string(data, "equipped_weapon_id"))
	run.equipped_armor_id = StringName(_read_string(data, "equipped_armor_id"))
	run.owned_equipment_ids_at_start = _read_string_array(data, "owned_equipment_ids_at_start")
	run.max_health = _read_int(data, "max_health", BASE_MAX_HEALTH, 1, 2_000_000_000)
	run.current_health = _read_int(data, "current_health", run.max_health, 0, run.max_health)
	run.attack = _read_int(data, "attack", BASE_ATTACK, 0, 2_000_000_000)
	run.defense = _read_int(data, "defense", BASE_DEFENSE, 0, 2_000_000_000)
	run.board_position = _read_int(data, "board_position", 0, 0, 2_000_000_000)
	run.board_locked = _read_bool(data, "board_locked")
	run.active_branch = _read_int(data, "active_branch", _RouteBranchData.NONE, _RouteBranchData.NONE, _RouteBranchData.ROUTE_B)
	run.active_fork_index = _read_int(data, "active_fork_index", -1, -1, 2_000_000_000)
	run.combats_won = _read_int(data, "combats_won", 0, 0, 2_000_000_000)
	run.elites_won = _read_int(data, "elites_won", 0, 0, 2_000_000_000)
	run.events_resolved = _read_int(data, "events_resolved", 0, 0, 2_000_000_000)
	run.treasures_found = _read_int(data, "treasures_found", 0, 0, 2_000_000_000)
	run.event_flag_ids = _read_string_name_array(data, "event_flag_ids")
	run.seen_event_ids = _read_string_name_array(data, "seen_event_ids")
